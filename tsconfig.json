{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": [
      "./worker-configuration.d.ts"
    ],
    "lib": [
      "ES2022"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ]
}