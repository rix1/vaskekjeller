{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vaskekjeller",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Listen on all interfaces so the dev server is reachable over Tailscale/LAN
  "dev": { "ip": "0.0.0.0", "port": 8787 },
  // Compiles client/*.ts (page script + service worker) into public/
  "build": { "command": "tsc -p client && tsc -p client/tsconfig.sw.json" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": false },
  // Created with `wrangler d1 create --jurisdiction eu`: data stays in the EU.
  // A D1 database's jurisdiction cannot be changed after creation.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vaskekjeller",
      "database_id": "ec66ae5d-4004-4ff3-a54e-f3ea3fbe4ce1",
      "migrations_dir": "migrations"
    }
  ],
  // Daily housekeeping: drop expired waitlist entries and yesterday's visitor hashes
  "triggers": { "crons": ["17 2 * * *"] },
  "vars": {
    // Where "/" redirects to while there is only one building (empty: no redirect)
    "DEFAULT_TENANT": "",
    "VAPID_SUBJECT": "mailto:rikardeide+vask@gmail.com"
  }
  // Secrets (wrangler secret put): SESSION_SECRET, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
}
